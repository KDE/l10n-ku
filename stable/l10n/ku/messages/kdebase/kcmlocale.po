#: localetime.cpp:521
msgid ""
"<p>This option determines which day will be considered as the first one of the "
"week.</p>"
msgstr ""
"<p>Bi vê vebijêrkê tu dikarî diyar bike bê ka bila roja pêşîn ya hefteyê kîjan "
"be. Em wekî Duşem qebûl dikin.</p>"

#: localetime.cpp:528
msgid ""
