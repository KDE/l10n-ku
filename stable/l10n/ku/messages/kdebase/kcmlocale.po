msgstr "Zimên Jê Bibî"

#: kcmlocale.cpp:74
msgid "Move Up"
msgstr "Bikişîne Jor"

#: kcmlocale.cpp:75
msgid "Move Down"
msgstr "Bikşîne Jêr"

#: kcmlocale.cpp:235
msgid "Other"
