#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Rêveberê danişîna KDE yê ewle ku protokola (XSMP) rêveberiya danişînê ya X11R6 "
"a Standart bi kar tîne."

#: main.cpp:35
msgid "Restores the saved user session if available"
msgstr "Heke pêkan be danişîna tomarkirî ji nû ve lê bar dike"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Heke rêvebereke din a paceyê di danişînê de tune be 'wm'ê dide destpêkirin. "
"'kwin'a bi pêşdanasîn."

#: main.cpp:38
msgid "Also allow remote connections"
msgstr "Destûrê bide pêwendiya ji dûr ve"

#: main.cpp:182
msgid "The KDE Session Manager"
msgstr "Rêveberê danişîna KDE"

#: main.cpp:186
msgid "Maintainer"
msgstr "Kesê miqet"

#: shutdown.cpp:349
msgid "Logout canceled by '%1'"
msgstr "Derketin ji hêla '%1' hat betalkirin"

#: shutdowndlg.cpp:102
msgid "End Session for \"%1\""
msgstr "Ji bo \"%1\" danişînê bigire"

#: shutdowndlg.cpp:128
msgid "&End Current Session"
msgstr "&Danişîna Heyî Bigire"

#: shutdowndlg.cpp:136
msgid "&Turn Off Computer"
msgstr "Kom&puterê bigire"

#: shutdowndlg.cpp:144
msgid "&Restart Computer"
msgstr "Komputerê &Ji nû ve veke"

#: shutdowndlg.cpp:164
msgid ""
"_: current option in boot loader\n"
" (current)"
msgstr " (aniha)"

