#: lock/autologout.cc:39
msgid "<nobr><qt><b>Automatic Log Out</b></qt><nobr>"
msgstr "<nobr><qt><b>Derketina bixweber</b></qt><nobr>"

#: lock/autologout.cc:40
msgid ""
"<qt>To prevent being logged out, resume using this session by moving the mouse "
"or pressing a key.</qt>"
msgstr ""
"<qt>Ji bo parastina ji derketinê, bi kurtasî ev beş bi livandina mişk an jî "
"pêlêkirina bişkojkê pêk tê .</qt>"

#: lock/autologout.cc:80
#, c-format
msgid ""
"_n: <nobr><qt>You will be automatically logged out in 1 second</qt></nobr>\n"
"<nobr><qt>You will be automatically logged out in %n seconds</qt></nobr>"
msgstr ""
"<nobr><qt>Piştî çirkeyek tu dê jixweber derkevî </qt></nobr>\n"
"<nobr><qt>Piştî %n çirke tu dê jixweber derkevî</qt></nobr>"

