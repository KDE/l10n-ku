#: audiooutput.cpp:443 audiooutput.cpp:477
#, qt-format
msgid ""
"<html>The audio playback device <b>%1</b> does not work.<br/>Falling back to "
"<b>%2</b>.</html>"
msgstr ""
"<html>Cîhaza lêdana stranan <b>%1</b> naxebite.<br/>Paşve vegerî <b>%2</b> "
"yê.</html>"

#: audiooutput.cpp:456
#, qt-format
msgid ""
"<html>Switching to the audio playback device <b>%1</b><br/>which just became "
"available and has higher preference.</html>"
msgstr ""
"<html>Bi cîhaza lêdana stranan <b>%1</b></br> re tê girêdan yê ku hema niha "
"amade bû û xwedî zêdetir taybetiyan e.</html>"

#: audiooutput.cpp:459 audiooutput.cpp:473
#, qt-format
msgid "Revert back to device '%1'"
msgstr "Paşve bizivirîne cîhaza '%1'"

#: audiooutput.cpp:470
#, fuzzy, qt-format
#| msgid ""
