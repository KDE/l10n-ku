#, kde-format
msgid "Failed to remove theme '%1'"
msgstr "Jê birîna dirba '%1' têk çû"

#: installer.cpp:375 installer.cpp:443
msgid "(Could not load theme)"
msgstr "(Nikare dirbê bar bike)"

