msgstr "Waldo Bastian"

#: kde-menu.cpp:114
#, kde-format
msgid "Author"
msgstr "Nivîskar"

#: kde-menu.cpp:119
#, kde-format
msgid "Output data in UTF-8 instead of local encoding"
msgstr "Di daneyên deranê de ji dêvla kodkirina herêmî ve UTF-8 bi kar bîne"

#: kde-menu.cpp:120
#, kde-format
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr ""
"Nasnameya pêşeka ku sepan tê de ye\n"
"nîşan bide"

#: kde-menu.cpp:121
#, kde-format
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr ""
"Navê (sernav) pêşeka ku sepan tê de ye\n"
"nîşan bide"

#: kde-menu.cpp:122
#, kde-format
msgid "Highlight the entry in the menu"
msgstr "Ketanê di pêşekê de bikirpîne"

#: kde-menu.cpp:123
#, kde-format
msgid "Do not check if sycoca database is up to date"
msgstr "Heke danegeha sycoca rojane be hilnebijêre"

#: kde-menu.cpp:124
#, kde-format
msgid "The id of the menu entry to locate"
msgstr "Nasnameya ketana pêşeka bê bicîkirin"

#: kde-menu.cpp:133
#, kde-format
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr "Divê wekî  'kde4-konsole.desktop'ê nasnameyeke sepanê diyar bikî"

#: kde-menu.cpp:142
#, kde-format
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr "Divê yek ji --print-menu-id, --print-menu-name û --highlight hilbijêrî"

#: kde-menu.cpp:164
#, kde-format
msgid "No menu item '%1'."
msgstr "Hêmana pêşekê ya '%1' tune."

#: kde-menu.cpp:168
#, kde-format
msgid "Menu item '%1' not found in menu."
msgstr "Hêmana pêşekê '%1' di pêşekê de nehat dîtin."
