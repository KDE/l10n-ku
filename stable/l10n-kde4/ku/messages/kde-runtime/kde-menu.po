#: kde-menu.cpp:93
#, kde-format
msgid "Menu item '%1' could not be highlighted."
msgstr "Hêmana pêşekê '%1' nehat kirpandin."

#: kde-menu.cpp:106
#, kde-format
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""
"Amûra lêpirsînê ya Pêşeka KDE.\n"
"Ev amûr ji bo dîtina ka kîjan sepan di kîjan pêşekê de ye, tê bikaranîn.\n"
"Vebijêrka --highlight nîşan dide ka sepaneke diyar di kîjan pêşeka\n"
"KDE'yê de ye."

#: kde-menu.cpp:111
#, kde-format
msgid "kde-menu"
msgstr "kde-menu"

