#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"URL ya Dûr %1\n"
"destûr tune ye bi --pelêntemp re "

#: main.cpp:216
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Pela demdemî tê hesibandin\n"
"%1\n"
"hatiye guherandin.\n"
"Tu dîsa jî dixwazî vê jê bibî?"

