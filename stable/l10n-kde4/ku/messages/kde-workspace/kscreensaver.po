#: random.cpp:48
#, kde-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"Bikaranîn: %1 [-setup] [arguman]\n"
"Dîmenderparêzeke çewalêhato dide destpêkirin.\n"
"Hemû arguman (ji bilî -setup'ê) ji bo dîmenderparêzê tên şandin."

#: random.cpp:55
#, kde-format
msgid "Start a random KDE screen saver"
msgstr "Dîmenderparêzê çewalêhato bide destpêkirin."

#: random.cpp:70
#, kde-format
msgid "Random screen saver"
msgstr "Dîmenderparêz çawalêhato"

#: random.cpp:76
#, kde-format
msgid "Setup screen saver"
msgstr "Dîmenderparêzê saz bike"

#: random.cpp:78
#, kde-format
msgid "Run in the specified XWindow"
msgstr "Di XWindowa hatiye diyarkirin de bixwbitîne"

#: random.cpp:80
#, kde-format
msgid "Run in the root XWindow"
msgstr "Di XWindowa root de bixebitîne"

#: random.cpp:194
#, kde-format
msgid "Setup Random Screen Saver"
msgstr "Dîmenderparêzê Çawalêhato Saz Bike"

#: random.cpp:202
#, kde-format
msgid "Use OpenGL screen savers"
msgstr "Dîmenderparêzên OpenGL bi kar bîne"

#: random.cpp:205
#, kde-format
msgid "Use screen savers that manipulate the screen"
msgstr "Dîmenderparêzên ku ekranê diguherînin bi kar bîne"
