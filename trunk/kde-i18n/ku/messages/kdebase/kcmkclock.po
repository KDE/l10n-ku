msgstr ""
"Jibo gohrîna Zone ya demê, Cihê runiştina xwe hilbijêre ji vê Lista "
"jêr:"

#: tzone.cpp:87 tzone.cpp:195
msgid "[No selection]"
msgstr "[Hilbijartin nîne]"

#: tzone.cpp:146
msgid "Unknown"
msgstr "Nenas"

#: tzone.cpp:286
msgid "Error setting new Time Zone!"
msgstr "Şaştî çêbu çaxha Zone ya demî hate sazkirin."

#: tzone.cpp:287
msgid "Timezone Error"
msgstr "Şaştîya Zone ya demî"

