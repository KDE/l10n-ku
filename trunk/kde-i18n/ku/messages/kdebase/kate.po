msgstr "Hema ku Doku&mentek aktiv bu"

#: app/katefileselector.cpp:520
msgid "When a document is o&pened"
msgstr "Hema ku Dokumentek v&ebbu"

#: app/katefileselector.cpp:521
msgid "When the file selector becomes visible"
msgstr "Hema ku Faîl hilbijêr hate xuyakirin"

