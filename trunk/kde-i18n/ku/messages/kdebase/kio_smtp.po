#: smtp.cc:262 smtp.cc:331
msgid "The sender address is missing."
msgstr "Navnîşana birêxerê aşkera nîne."

#: smtp.cc:273
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "SMTPProtocol::smtp_open çênebû (%1)"

#: smtp.cc:282
msgid ""
"The server did not accept the sender address.\n"
"The server responded: \"%1\""
msgstr ""
"Xûyaye Server navnîşana birêxerê nasnake:\n"
"Bersîva server: %1"

#: smtp.cc:305
msgid ""
"The attempt to start sending the message content failed.\n"
"The server responded: \"%1\""
msgstr ""
"Şandina peyamê hate şikandin.\n"
"Bersîva Server: %1"

#: smtp.cc:377
msgid ""
"The message content was not accepted.\n"
"The server responded: \"%1\""
msgstr ""
"Naweroka peyamê nehate qebulkirin.\n"
"Bersîva Server: \"%1\""

#: smtp.cc:394
msgid ""
"One of the recipients was not accepted.\n"
"The server responded: \"%1\""
msgstr ""
"Yek ji wan recpektoran nehate qebulkirin.\n"
"Bersîva Server: \"%1\""

#: smtp.cc:462 smtp.cc:485
msgid "Invalid SMTP response received."
msgstr "Bersîva SMTP ya şaş hate gehîştin."

#: smtp.cc:518
msgid "Invalid SMTP response received: \"%1\""
msgstr "Bersîva SMTP ya şaş hate gehîştin: %1"

#: smtp.cc:569
msgid "The server did not accept the connection: \"%1\""
msgstr "Server naxwaze peywendî çêke: %1"

#: smtp.cc:607 smtp.cc:655
msgid "The server responded: \"%1\""
msgstr "Bersîva Server: %1"

#: smtp.cc:631
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"Xûyaye SMTP-Server alîkarîya TLS-Protokol dike, lê hevpeyîvîn ligor wê jî çênebû.\n"
"Tu kari bikarînana TLS di Sentera kontrolê ya KDE neaktîvbike."

#: smtp.cc:636
msgid "Connection Failed"
msgstr "Peywendî hate şikandin"

#: smtp.cc:676
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"Xûyaye SMTP-Server alîkarîya TLS-Protokol dike, lê hevpeyîvîn ligor wê jî çênebû.\n"
"Heger tu dixwazî TLS nakara (neaktîv) bike jibo ku peywendî bê klîldan \"encryption\" "
"çêbibe."

#: smtp.cc:688
msgid "Username and password for your SMTP account:"
msgstr "Navê bikarhêner û password jibo SMTP account:"

#: smtp.cc:690
msgid "When prompted, you ran away."
msgstr "Heger prompt hat, ête hema biajo."

#: smtp.cc:737
msgid "No compatible authentication methods found."
msgstr "Methodeke Authentifikationê ligor wê ne hate dîtin."

#: smtp.cc:758
msgid ""
"Your SMTP server doesn't support %1.\n"
"Choose a different authentication method."
msgstr ""
"SMTP-Server alîkarîyê %1 nake.\n"
"Bifermîne û methodeke authentifikationeke din hilbijêre."

#: smtp.cc:788
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded: \"%1\""
msgstr ""
"Authentifikation hate şikandin.\n"
"Lewaneye ku password ne rast bu.\n"
"Bersîva Server: %1"

