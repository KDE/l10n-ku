#: main.cpp:47
msgid "KFM Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KFM Exec - Jibo vekkirina faîlan liser komputerê dûr, jibo tu nasbike ku "
"guhertin yan jî nuhkirin çêbuye yan na"

#: main.cpp:53
msgid "Command to execute."
msgstr "Ferman jibo ajotin."

#: main.cpp:54
msgid "URL(s) or local file used for 'command'."
msgstr "URL(an) yan faîla xoceh (local), yê ku jibo 'command' divê bê bikarîn."

#: main.cpp:70
msgid ""
"'command' expected.\n"
msgstr ""
"Lihêvîya 'ferman'.\n"

#: main.cpp:93
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"Ew URL %1\n"
"ne raste."

#: main.cpp:211
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Ew faîl\n"
"%1\n"
"hatîye guhertin\n"
"Tu dixwazi wan guhertinan bîne barkirin?"

#: main.cpp:212
msgid "File Changed"
msgstr "Faîl hate guhertin"

#: main.cpp:234
msgid "KFMExec"
msgstr "KFMExec"

#: main.cpp:249
msgid ""
"Syntax Error:\n"
"kfmexec command [URLs ...]"
msgstr ""
"Şaştîyên Syntax (rastnivîsî):\n"
"fermana kfmexec [URL ....]"

