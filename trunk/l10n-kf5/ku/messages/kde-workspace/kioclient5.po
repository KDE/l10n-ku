"  kioclient ls 'url'\n"
"            # Lists the contents of the directory 'url' to stdout\n"
"\n"
msgstr ""
"  kioclient cat 'url'\n"
"            # Naveroka 'url' yê dinivîse di nav stdout de\n"
"\n"

