msgstr ""
"Ji dil dixwazî \"%1\"ê çalak bikî û \"%2\", \"%3\" û \"%4\"ê neçalak bikî?"

#: kaccess.cpp:805
#, kde-format
msgid "Do you really want to activate \"%1\" and \"%2\"?"
msgstr "Ji dil dixwazî \"%1\"û \"%2\"ê çalak bikî?"

#: kaccess.cpp:808
#, kde-format
msgid ""
"Do you really want to activate \"%1\" and \"%2\" and to deactivate \"%3\"?"
