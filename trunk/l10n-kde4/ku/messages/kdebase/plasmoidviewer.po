#: main.cpp:44
msgid "Run Plasma widgets in their own window"
msgstr "Alavên Plasmayê di paceya wê de nîşan bide"

#: main.cpp:48
msgid "Plasma Widget Viewer"
msgstr "Nîşandêra Alavên Plasma"

#: main.cpp:50
msgid "2007-2008, Frerich Raabe"
msgstr "2007-2008, Frerich Raabe"

#: main.cpp:52
msgid "Frerich Raabe"
msgstr "Frerich Raabe"

#: main.cpp:53
msgid "Original author"
msgstr "Nivîskarê resen"

#: main.cpp:59
msgid "Displays a list of known applets"
msgstr "Lîsteyekî sepanokên tên nas kirin nîşan bide"

#: main.cpp:61
msgctxt "Do not translate horizontal, vertical, mediacenter nor planar"
msgid "The formfactor to use (horizontal, vertical, mediacenter or planar)"
msgstr "Formfactor ji bo bi kar anîna (dirêjkirî, çik, navendî an jî rast)"

#: main.cpp:63
msgctxt ""
"Do not translate floating, desktop, fullscreen, top, bottom, left nor right"
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, top, bottom, left, right)"
msgstr ""
"Cih sînor kirî ye ji bo destpê kirina Parastinê digel (herikîn, sermase, "
"dîmender tijî, jor, jêr, çep, rast)"

#: main.cpp:65
msgid "Name of the containment plugin"
msgstr "Navê pêveka parastinê"

#: main.cpp:67
msgid "Name of the wallpaper plugin"
msgstr "Navê pêveka wêneya rûerdê"

#: main.cpp:69
msgid "The size in KB to set the pixmap cache to"
msgstr "Mezinahiya KB'î ji bo berhevkirina piksmapê ji bo"

#: main.cpp:70
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""

#: main.cpp:73
msgid "Optional arguments of the applet to add"
msgstr "Nîqaşên vebijêrkî yên alavê têxistinê"

#: main.cpp:97
msgid "No description available"
msgstr "Tu rave tune ye"

