msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance & Themes -> Colors in the Control Center and disable the "
"checkbox\n"
"# \"Apply colors to non-KDE applications\"\n"
"#\n"
"#\n"
msgstr ""
"# Ji aliyê KDE hatiye afirandin, %1\n"
"#\n"
"# Heke nexwazî KDE mîhengên te yên GTK biguherîne,\n"
"# Appearance & Themes -> Colors di Navenda Kontrolê de hilbijêre û qutika \n"
"# \"Apply colors to non-KDE applications\" neçalak bike.\n"
"#\n"
"#\n"
