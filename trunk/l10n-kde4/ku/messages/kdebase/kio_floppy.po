#: kio_floppy.cpp:198
#, kde-format
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"Nikare bigihîje ajokera %1.\n"
"Ajoker hêj mijûl e.\n"
"Heta ev neçalak bibe bisekine û paşê cardin biceribîne."

#: kio_floppy.cpp:202 kio_floppy.cpp:1116
#, kde-format
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"Nivîsandina li pelê %1 biserneket.\n"
"Qey dîska li ajogera %2 tijî ye."

#: kio_floppy.cpp:212
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"Nikare bigihîje ajokera %1.\n"
"Qey di ajokera %2 de dîsk tune ye"

#: kio_floppy.cpp:216
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough "
"permissions to access the drive."
msgstr ""
"Nikare bigihîje ajokera %1.\n"
"Qey di ajokera %2 de dîsk tune ye an jî tu têra gihîştina ajokerê xwedî "
"mafan nîn î."

#: kio_floppy.cpp:220
#, kde-format
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"Nikare bigihîje ajokera %1.\n"
"Piştgirî ajokera %2 ê re nayê kirin."

#: kio_floppy.cpp:225
#, kde-format
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"Nikare bigihîje %1.\n"
"Piştrast bike ku dîsketa di ajokera %2 de dîsketa bi DOS-teşekirî ye \n"
"û destûrên pela cîhazê (mînak /dev/fd0) rast hatiye veava kirin (mînak "
"rwxrwxrwx). "

#: kio_floppy.cpp:229
#, kde-format
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"Nikare bigihîje %1.\n"
"Dîska di ajokera %2 de di be ku dîsketa bi DOS-teşekirî nebe."

#: kio_floppy.cpp:233
#, kde-format
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"Gihîştin nehat dayin.\n"
"Nikare binivîse ser %1.\n"
"Dîska di ajokera %2 de di be ku nivîsîn-parastî be."

#: kio_floppy.cpp:242
#, kde-format
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"Nikare beşa boot  ji bo %1. bixwîne\n"
"Qey di ajokera %2 de dîsk tune ye."

#: kio_floppy.cpp:365
#, kde-format
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"Nikare bernameya \"%1\" bide destpêkirin.\n"
"Piştrast bike ku pakêta mtools bê-çewtî di pergala te de hatiye saz kirin."
