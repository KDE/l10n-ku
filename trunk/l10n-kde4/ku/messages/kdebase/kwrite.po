#: kwriteapp.cpp:145
#, kde-format
msgid ""
"The file '%1' could not be opened: it is not a normal file, it is a folder."
msgstr "Pelê  '%1'  nehat vekirin: ne pelekî ji rêzê ye, peldankek e."

