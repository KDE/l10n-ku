#: kwritemain.cpp:71 kwritemain.cpp:489
msgid ""
"A KDE text-editor component could not be found;\n"
"please check your KDE installation."
msgstr ""
"Serastkereke nivîsan a KDE'yê nehat dîtin;\n"
"ji kerema xwe re sazkirina xwe ya KDE'yê kontrol bike."

#: kwritemain.cpp:144
msgid "Use this to close the current document"
msgstr "Ji bo girtina belgeya derbasdar, vê bi kar bîne"

#: kwritemain.cpp:148
msgid "Use this command to create a new document"
msgstr "Ji bo afirandina belgeyeke nû vê fermanê bi kar bîne"

#: kwritemain.cpp:150
msgid "Use this command to open an existing document for editing"
msgstr "Ji bo ku belgeyeke heyî ji bo guherandinê vekî, vê fermanê bi kar bîne"

#: kwritemain.cpp:154
msgid ""
"This lists files which you have opened recently, and allows you to easily "
"open them again."
msgstr ""
"Ev lîsteya pelên ku te di dawiyê de vekirine ye û dikarî xwe pê bi hêsanî "
"bigihînî van pelan."

#: kwritemain.cpp:158
msgid "&New Window"
msgstr "&Pencereya nû"

#: kwritemain.cpp:160
msgid "Create another view containing the current document"
msgstr "Belgeya niha di paceyeke din de veke"

#: kwritemain.cpp:163
msgid "Choose Editor..."
msgstr "Editorê Hilbijêre..."

#: kwritemain.cpp:165
msgid "Override the system wide setting for the default editing component"
msgstr ""
"Ji bo serastkirina parçeya standard, li ser mîhengên pêşsalixbûyî ên pergalê "
"binivîse"

#: kwritemain.cpp:168
msgid "Close the current document view"
msgstr "Belgeya derbasdar bigire"

#: kwritemain.cpp:175
msgid "Use this command to show or hide the view's statusbar"
msgstr "Ji bo nîşandan/veşartina darikê rewşê, vê fermanê bi kar bîne"

#: kwritemain.cpp:177
msgid "Sho&w Path"
msgstr "Rê Nî&şan Bide"

#: kwritemain.cpp:180
msgid "Show the complete document path in the window caption"
msgstr "Di sernivîsa paceyê de tevahiya riya belgeyê nîşan bide"

#: kwritemain.cpp:183
msgid "Configure the application's keyboard shortcut assignments."
msgstr "Ji bo sepanê, kurteriyên klavyeyê diyar bike."

#: kwritemain.cpp:187
msgid "Configure which items should appear in the toolbar(s)."
msgstr "Mîheng bike ka kîjan bireser di darikê amûran de bê nîşandan."

#: kwritemain.cpp:190
msgid "&About Editor Component"
msgstr "Di Derbarê Yekbûnên Editorê De"

#: kwritemain.cpp:206
msgid " INS "
msgstr " INS "

#: kwritemain.cpp:210 kwritemain.cpp:557
msgctxt "@info:status Statusbar label for line selection mode"
msgid " LINE "
msgstr " RÊZIK "

#: kwritemain.cpp:270
msgid "Open File"
msgstr "Pelî Veke"

#: kwritemain.cpp:285
msgid ""
"The given file could not be read, check if it exists or if it is readable "
"for the current user."
msgstr ""
"Ev pel nehat xwendin, kontrol bike ka pelekî wisa heye an na û ka destûra "
"bikarhêner ji bo xwendina wê heye an na"

#: kwritemain.cpp:550
#, kde-format
