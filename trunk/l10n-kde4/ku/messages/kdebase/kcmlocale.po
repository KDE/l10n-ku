#: localetime.cpp:591
msgid ""
"<p>This option determines which day will be considered as the first one of "
"the week.</p>"
msgstr ""
"<p>Bi vê vebijêrkê tu dikarî diyar bike bê ka bila roja pêşîn ya hefteyê "
"kîjan be. Em wekî Duşem qebûl dikin.</p>"

#: localetime.cpp:596
msgid ""
"<p>This option determines which day will be considered as the first working "
"day of the week.</p>"
msgstr ""
"<p>Bi vê vebijêrkê tu dikarî diyar bike bê ka bila roja xebatê ya pêşîn ya "
"hefteyê kîjan be.</p>"

#: localetime.cpp:601
msgid ""
"<p>This option determines which day will be considered as the last working "
"day of the week.</p>"
msgstr ""
"<p>Bi vê vebijêrkê tu dikarî diyar bike bê ka bila roja xebatê ya pêşîn ya "
"hefteyê kîjan be.</p>"

#: localetime.cpp:606
msgid ""
"<p>This option determines which day will be considered as the day of the "
"week for religious observance.</p>"
msgstr ""
"<p>Bi vê vebijêrkê tu dikarî diyar bike bê ka bila roja pêkanînên olî be.</p>"

#: localetime.cpp:613
msgid ""
"<p>This option determines whether possessive form of month names should be "
"used in dates.</p>"
msgstr "<p>Ev vebijêrk, di vebijêrkên dîrokê de mehên kurtkirî bikar tîne.</p>"

