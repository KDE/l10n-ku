#: appletbrowser.cpp:469
msgid "Close the dialog"
msgstr "Pace yê bigire"

#: appletbrowser.cpp:470
msgid ""
"<qt>When clicking <b>Close</b>, this dialog will be closed with no further "
"action taken.</qt>"
msgstr ""
"<qt>Di tikandinê de<b>Girtin</b>, ev pace bê kirina tiştekî din dê were "
"girtin.</qt>"

#: appletbrowser.cpp:471
msgid "Add selected widgets"
msgstr "Alavên hilbijartî têxe"

#: appletbrowser.cpp:472
msgid ""
"<qt>When clicking <b>Add Widget</b>, the selected widgets will be added to "
"your desktop.</qt>"
msgstr ""
"<qt>Di tikandinê de<b>Alavan Têxê</b>, alavên hilbijartî dê lê sermase ya te "
"bên zêde kirin."

#: appletbrowser.cpp:473
msgid "Install new widgets"
msgstr "Alavên nû saz bike"

#: appletbrowser.cpp:474
msgid ""
"<qt>Selecting <b>Get New Widgets</b> will show a window that allows you to "
"download new widgets directly from the Internet, while Install From File "
"allows you to add new widgets from files you have on disk.</qt>"
msgstr ""
"<qt>Hilbijartina <b>Alavên Nû Bîne</b> wê paceyekê veke yê dihêleku raste "
"rast jê înternetê alavên nû bên daxistin, Jê Pelê Saz Bike jî dihêle ku tu "
"alavên nû jê pelên  di dîska te de hene saz bikî.</qt> "

