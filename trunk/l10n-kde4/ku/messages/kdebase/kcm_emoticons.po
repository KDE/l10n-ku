#: emoticonslist.cpp:66
msgid ""
"Insert the string for the emoticon.  If you want multiple strings, separate "
"them by spaces."
msgstr ""

#: emoticonslist.cpp:107
msgid "Emoticons"
msgstr "Vegotin"

#: emoticonslist.cpp:254
msgid "Drag or Type Emoticon Theme URL"
msgstr "URL ya Dirba Vegotinê Bikişîne an jî Binivîse"

#: emoticonslist.cpp:259
msgid "Emoticon themes must be installed from local files."
msgstr ""
"Dirbên vegotinê pêwist e jê pelên di komputera te de hene bên saz kirin."

#: emoticonslist.cpp:260
msgid "Could Not Install Emoticon Theme"
msgstr "Nikare Dirba Vegotinê Saz Bike"

#: emoticonslist.cpp:278
#, kde-format
msgid "Do you want to remove %1 too?"
msgstr "Tu dixwazî %1 jî jê bibî?"

#: emoticonslist.cpp:278
msgid "Delete emoticon"
msgstr "Vegotinê jê bibe"

#: emoticonslist.cpp:294
msgid "Add Emoticon"
msgstr "Vegotin Lê Zêde Bike"

#: emoticonslist.cpp:318
msgid "Edit Emoticon"
msgstr "Vegotin Biguherîne"

#: emoticonslist.cpp:364 emoticonslist.cpp:387
msgid "New Emoticon Theme"
msgstr "Dirba Vegotina Nû"

#: emoticonslist.cpp:364
msgid "Enter the name of the new emoticon theme:"
msgstr "Navê dirba vegotina nû binivîse:"

#: emoticonslist.cpp:370
#, kde-format
msgid "%1 theme already exists"
msgstr "Dirba %1 jixwe heye"

#: emoticonslist.cpp:387
msgid "Choose the type of emoticon theme to create"
msgstr "Cureyê dirba vegotinê hilbijêre û biafirîne"

#. i18n: file: emoticonslist.ui:13
#. i18n: ectx: property (windowTitle), widget (QWidget, EmoticonsManager)
#: rc.cpp:3
msgid "Emoticons Manager"
msgstr "Rêveberê Vegotinan"

#. i18n: file: emoticonslist.ui:44
#. i18n: ectx: property (toolTip), widget (KPushButton, btAdd)
#: rc.cpp:6
msgid "Create a new emoticon"
msgstr "Vegotina nû biafirîne"

#. i18n: file: emoticonslist.ui:47
#. i18n: ectx: property (whatsThis), widget (KPushButton, btAdd)
#: rc.cpp:9
msgid "Create a new emoticon by assigning it an icon and some text"
msgstr "Vegotina nû biafirîne bi vê re îkon û hinek nivîsar zêdekirinê ve"

#. i18n: file: emoticonslist.ui:50
#. i18n: ectx: property (text), widget (KPushButton, btAdd)
#: rc.cpp:12
msgid "Add..."
msgstr "Têxê..."

#. i18n: file: emoticonslist.ui:57
#. i18n: ectx: property (toolTip), widget (KPushButton, btEdit)
#: rc.cpp:15
msgid "Modify the selected emoticon icon or text "
msgstr "Îkona an jî nivîsara vegotinê yê hilbijartî biguherîne"

#. i18n: file: emoticonslist.ui:60
#. i18n: ectx: property (whatsThis), widget (KPushButton, btEdit)
#: rc.cpp:18
msgid "Edit the selected emoticon to change its icon or its text"
msgstr "Îkon an jî nivîsara vegotina hilbijartî biguherîne"

#. i18n: file: emoticonslist.ui:63
#. i18n: ectx: property (text), widget (KPushButton, btEdit)
#: rc.cpp:21
msgid "Edit..."
msgstr "Biguherîne..."

#. i18n: file: emoticonslist.ui:70
#. i18n: ectx: property (toolTip), widget (KPushButton, btRemoveEmoticon)
#: rc.cpp:24
msgid "Remove the selected emoticon"
msgstr "Vegotina hilbijartî rake"

#. i18n: file: emoticonslist.ui:73
#. i18n: ectx: property (whatsThis), widget (KPushButton, btRemoveEmoticon)
#: rc.cpp:27
msgid "Remove the selected emoticon from your disk"
msgstr "Vegotina hilbijartî jê dîska xwe rake"

#. i18n: file: emoticonslist.ui:76
#. i18n: ectx: property (text), widget (KPushButton, btRemoveEmoticon)
#: rc.cpp:30
msgid "Remove"
msgstr "Rake"

#. i18n: file: emoticonslist.ui:100
#. i18n: ectx: property (text), widget (QCheckBox, cbStrict)
#: rc.cpp:33
msgid "Require spaces around emoticons"
msgstr "Cihê hewce ji bo derdora vegotinan"

#. i18n: file: emoticonslist.ui:107
#. i18n: ectx: property (toolTip), widget (KPushButton, btNew)
#: rc.cpp:36
msgid "Design a new emoticon theme"
msgstr "Dirba vegotinekê nû biafirîne"

#. i18n: file: emoticonslist.ui:110
#. i18n: ectx: property (whatsThis), widget (KPushButton, btNew)
#: rc.cpp:39
msgid ""
"Start a new theme by assigning it a name. Then use the Add button on the "
"right to add emoticons to this theme."
msgstr ""
"Bi nav danê ve destpê dirba nû bike. Paşê pêl bişkojka Têxê yê di milê rastê "
"de ye bike û vegotinan lê vê dirbê zêde bike."

#. i18n: file: emoticonslist.ui:113
#. i18n: ectx: property (text), widget (KPushButton, btNew)
#: rc.cpp:42
msgid "New Theme..."
msgstr "Dirbê Nû..."

#. i18n: file: emoticonslist.ui:120
#. i18n: ectx: property (toolTip), widget (KPushButton, btGetNew)
#: rc.cpp:45
#, fuzzy
#| msgid "Get new themes from the Internet"
msgid "Get new icon themes from the Internet"
msgstr "Jê Torê dirbên nû bîne"

#. i18n: file: emoticonslist.ui:123
#. i18n: ectx: property (whatsThis), widget (KPushButton, btGetNew)
#: rc.cpp:48
msgid ""
"You need to be connected to the Internet to use this action. A dialog will "
"display a list of emoticon themes from the http://www.kde.org website. "
"Clicking the Install button associated with a theme will install this theme "
"locally."
msgstr ""
"Ji bo bi kar anîna vê çalakî yê, girêdana torê hewce ye. Pace yek ê vebe û "
"jê malpera http://www.kde.org lîsteya vegotinan nîşan bide. Bi pêl bişkojka "
"saz bike yê rexê dirbê heyî re ev dirb ê bê saz kirin. "

#. i18n: file: emoticonslist.ui:126
#. i18n: ectx: property (text), widget (KPushButton, btGetNew)
#: rc.cpp:51
#, fuzzy
#| msgid "Get New Themes..."
msgid "Get New Icon Themes..."
msgstr "Dirbê Nû Bîne..."

#. i18n: file: emoticonslist.ui:133
#. i18n: ectx: property (toolTip), widget (KPushButton, btInstall)
#: rc.cpp:54
msgid "Install a theme archive file you already have locally"
msgstr "Pela arşîva dirbê yê jixwe di komputera te de heye saz bike"

#. i18n: file: emoticonslist.ui:136
#. i18n: ectx: property (whatsThis), widget (KPushButton, btInstall)
#: rc.cpp:57
msgid ""
"If you already have an emoticon theme archive locally, this button will "
"unpack it and make it available for KDE applications"
msgstr ""
"Heke tu jixwe di komputera te de arşîva dirba vegotinekê hebe, ev bişkojk ê "
"arşîvê veke û vê ji bo sepanên KDE amade bike."

#. i18n: file: emoticonslist.ui:139
#. i18n: ectx: property (text), widget (KPushButton, btInstall)
#: rc.cpp:60
msgid "Install Theme File..."
msgstr "Pelê Dirban Saz Bike..."

#. i18n: file: emoticonslist.ui:146
#. i18n: ectx: property (toolTip), widget (KPushButton, btRemoveTheme)
#: rc.cpp:63
msgid "Remove the selected theme from your disk"
msgstr "Dirbên hatine hilbijartin jê dîska xwe bibe"

#. i18n: file: emoticonslist.ui:149
#. i18n: ectx: property (whatsThis), widget (KPushButton, btRemoveTheme)
#: rc.cpp:66
msgid "This will remove the selected theme from your disk."
msgstr "Ev wê dirbên hatine hilbijartin jê dîska te bibe."

#. i18n: file: emoticonslist.ui:152
#. i18n: ectx: property (text), widget (KPushButton, btRemoveTheme)
#: rc.cpp:69
msgid "Remove Theme"
msgstr "Dirbî Rake"

