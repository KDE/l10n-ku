#: passwddlg.cpp:34 passwddlg.cpp:101
#, fuzzy
#| msgid "Change Password"
msgctxt "@title:window"
msgid "Change Password"
msgstr "Şîfre Biguherîne"

#: passwddlg.cpp:35
msgid "Please enter your current password:"
msgstr "Jê kerema xwe şîfreya xwe yê heyî binivîse:"

#: passwddlg.cpp:55 passwddlg.cpp:179
msgid "Conversation with 'passwd' failed."
msgstr "Danişîna bi 'passwd' têk çû."

#: passwddlg.cpp:65
msgid "Could not find the program 'passwd'."
msgstr "Nikare bernameya 'passwd' bibîne."

#: passwddlg.cpp:70
msgid "Incorrect password. Please try again."
msgstr "Şîfre şaştî ye. Jê kerema xwe cardin biceribînin."

#: passwddlg.cpp:74
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr ""
"Çewtiya navxweyî: paş de vegera ne derbasdar ji PasswdProcess::checkCurrent."

#: passwddlg.cpp:103
msgid "Please enter your new password:"
msgstr "Jê kerema xwe şîfreya xwe yê nû binivîse:"

#: passwddlg.cpp:105
#, kde-format
msgid "Please enter the new password for user <b>%1</b>:"
msgstr "Jê kerema xwe şîfreya nû ji bo bikarhêner <b>%1</b> binivîse:"

#: passwddlg.cpp:127
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"Şîfreya te 8 tîpan zêdetir e. Hinek pergalan de, ev dibe sedema pirsgirêkan. "
"Tu dikarî şîfreyê bixî 8 tîpan, an jî wisa bihêlî."

#: passwddlg.cpp:130
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"Şîfreya te 8 tîpan zêdetir e. Hinek pergalan de, ev dibe sedema pirsgirêkan. "
"Tu dikarî şîfreyê bixî 8 tîpan, an jî wisa bihêlî."

#: passwddlg.cpp:134
msgid "Password Too Long"
msgstr "Şîfre Pir Dirêj e"

#: passwddlg.cpp:135
msgid "Truncate"
msgstr "Bixe"

#: passwddlg.cpp:136
msgid "Use as Is"
msgstr "Wekî ls bi kar bîne"

#: passwddlg.cpp:158
msgid "Your password has been changed."
msgstr "Şîfreya te hate guherandin."

#: passwddlg.cpp:168
msgid "Your password has not been changed."
msgstr "Şîfreya te nehat guherandin."
