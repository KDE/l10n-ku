#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - Pelên dûr vedike, guherandinan dinihêre, ji bo bar kirinê dipirse"

#: main.cpp:80
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL ya %1\n"
"xera bûye "

#: main.cpp:82
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"URL ya Dûr %1\n"
"destûr tune ye bi --pelêntemp re "

#: main.cpp:213
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Pela demdemî tê hesibandin\n"
"%1\n"
"hatiye guherandin.\n"
"Tu dîsa jî dixwazî vê jê bibî?"

#: main.cpp:214 main.cpp:221
msgid "File Changed"
msgstr "Pel Guherî"

#: main.cpp:214
msgid "Do Not Delete"
msgstr "Jê Nebe"

#: main.cpp:220
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Pela\n"
"%1\n"
"hate guherandin.\n"
"Tu dixwazî guherandinan bar bikî?"

#: main.cpp:221
msgid "Upload"
msgstr "Bar bike"

#: main.cpp:221
