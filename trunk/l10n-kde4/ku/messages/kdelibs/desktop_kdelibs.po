msgctxt "Name"
msgid "Python encoding checker/adder"
msgstr "Python kod kirina kontrolker/lê zêdeker ê"

#: kate/plugins/pythonencoding/ktexteditor_python-encoding.desktop:62
msgctxt "Comment"
msgid "While saving check encoding of python files and add an encoding line"
