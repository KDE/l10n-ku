#: interfaces/kimproxy/interface/dbusinstantmessenger.desktop:4
msgctxt "Comment"
msgid "Instant Messenger with a D-Bus interface"
msgstr "Peyamkera Têgihan bi navrû ya D-Bus"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:2
#, fuzzy
#| msgctxt "Name"
#| msgid "Instant Messenger"
msgctxt "Name|standard desktop component"
msgid "Instant Messenger"
msgstr "Peyamkera Têgihan"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:31
msgctxt "Comment"
msgid ""
"The instant messenger allows two-way chat between individuals and groups."
msgstr ""
"Peyamkera têgihan dihêle ku du rê yan ve hevpeyvîn di navbera şexsan û koman "
"de bê kirin."

#: interfaces/kspeech/dbustexttospeech.desktop:4
msgctxt "Comment"
msgid "Text-to-Speech Service with a D-Bus interface"
msgstr "Servîsa Axaftin-bi-Nivîsê bi navrû ya D-Bus"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:2
#, fuzzy
#| msgctxt "Name"
#| msgid "Embedded Text Editor"
msgctxt "Name|standard desktop component"
msgid "Embedded Text Editor"
msgstr "Edîtora Nivîsê yê Jixwe Heyî"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:34
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"Servîsa edîtora nivîsê sepanên bi nîşanderê nivîsê û edîtorê nivîsê re peyda "
"dike. Sepanên KDE yên ku derfetên nivîsandinê peyda dike divê vê servîsê bi "
"kar bîne."

#: interfaces/ktexteditor/ktexteditor.desktop:5
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr "Perçe ya Edîtora Nivîsê yê Jixwe Heyî (bi Doc/Dîtina Cuda kirinê)  "

#: interfaces/ktexteditor/ktexteditor_loadsavefiltercheckplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor load/save filter/check plugin"
msgstr "KEdîtoraNivîsê pêveka barbike/tomarbike parzûnbike/kontrolbike"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "Pêveka KEdîtoraNivîsê"

#: kate/data/katepart.desktop:2
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Edîtora Nivîsê ya Pêşketî yê Jixwe Heyî"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:16
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Bixweberbijarteker"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:88
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr ""
"Danîşanan ava bike ser rêzên hevgirtî bi mînak re demê pelên nivîsê tên bar "
"kirin "

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:17
msgctxt "Name"
msgid "Insert File"
msgstr "Pelî lê zêde bike"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:97
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Çi pelê paknivîs hebe bike di cihê bernîşane de"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:17
msgctxt "Name"
msgid "Data Tools"
msgstr "Amûrên Dane yan"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:87
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
