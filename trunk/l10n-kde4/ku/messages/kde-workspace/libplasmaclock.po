msgstr "Demjimêr standard e ji bo:"

#. i18n: ectx: property (toolTip), widget (QComboBox, clockDefaultsTo)
#: timezonesConfig.ui:89
msgid "The time the clock will display"
msgstr "Dem û demjimêr wê bê nîşandan"

